{
  "schemaVersion": 2,
  "minimumHostAPIVersion": 2,
  "identifier": "com.copythat.example.edit-in-preview",
  "name": {
    "en": "Edit in Preview",
    "zh-Hans": "在预览中编辑"
  },
  "description": {
    "en": "Open copied images and Finder image files in the macOS Preview app.",
    "zh-Hans": "使用 macOS“预览”打开复制的图片或从访达复制的图片文件。"
  },
  "systemImage": "pencil.and.scribble",
  "matches": [
    "image",
    "imageFiles"
  ],
  "permissions": [
    "clipboard.readImage",
    "clipboard.readFiles",
    "system.openApplication"
  ],
  "action": {
    "type": "runScript",
    "title": {
      "en": "Edit in Preview",
      "zh-Hans": "在预览中编辑"
    }
  },
  "script": "function run(context) { return copythat.openCopiedContent(\"com.apple.Preview\"); }"
}
