{
  "schemaVersion": 2,
  "minimumHostAPIVersion": 1,
  "identifier": "com.copythat.example.edit-in-preview",
  "name": {
    "en": "Edit in Preview",
    "zh-Hans": "在预览中编辑"
  },
  "description": {
    "en": "Open the copied image in the macOS Preview app.",
    "zh-Hans": "使用 macOS 预览 App 打开并编辑复制的图片。"
  },
  "systemImage": "pencil.and.scribble",
  "matches": [
    "image"
  ],
  "permissions": [
    "clipboard.readImage",
    "system.openApplication"
  ],
  "action": {
    "type": "runScript",
    "title": {
      "en": "Edit in Preview",
      "zh-Hans": "在预览中编辑"
    }
  },
  "script": "function run(context) { return copythat.openCopiedContent(\"com.apple.Preview\"); }"
}
